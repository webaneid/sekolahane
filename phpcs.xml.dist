<?xml version="1.0"?>
<ruleset name="Webane WordPress Theme">
	<description>Standar coding theme Webane (WPCS + kompatibilitas PHP 8.0+).</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<config name="testVersion" value="8.0-"/>
	<config name="minimum_wp_version" value="6.0"/>

	<rule ref="WordPress">
		<!-- Template theme klasik: nama file mengikuti template hierarchy WP -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Yoda condition tidak diwajibkan (lihat docs/conventions.md) -->
		<exclude name="WordPress.PHP.YodaConditions"/>
		<!-- Komentar boleh tanpa titik di akhir -->
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sekolahane"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="sekolahane"/>
			</property>
		</properties>
	</rule>
</ruleset>
